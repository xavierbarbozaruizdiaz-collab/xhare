{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start-metro-android.cjs",
    "start:clear": "node scripts/start-metro-android.cjs --clear",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:passenger": "cross-env APP_FLAVOR=passenger node scripts/start-metro-android.cjs",
    "start:driver": "cross-env APP_FLAVOR=driver node scripts/start-metro-android.cjs",
    "android": "expo run:android --variant debug",
    "android:run": "expo run:android --variant debug",
    "android:passenger": "cross-env APP_FLAVOR=passenger expo run:android --variant debug",
    "android:driver": "cross-env APP_FLAVOR=driver expo run:android --variant debug",
    "android:debug:install": "cross-env REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo run:android --variant debug --no-bundler",
    "android:passenger:debug:install": "cross-env APP_FLAVOR=passenger REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo run:android --variant debug --no-bundler",
    "android:passenger:no-bundler": "cross-env APP_FLAVOR=passenger node scripts/run-android-debug-no-bundler.cjs",
    "android:driver:no-bundler": "cross-env APP_FLAVOR=driver node scripts/run-android-debug-no-bundler.cjs",
    "android:emulator": "node scripts/start-android-emulator-safe.cjs",
    "android:recover": "node scripts/recover-android-dev.cjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "npm run check:ts",
    "check:ts": "tsc --noEmit",
    "icons:android": "cross-env APP_FLAVOR=passenger node scripts/sync-android-launcher-icons.cjs",
    "build:android:release": "node scripts/run-android-release-flavor.cjs both",
    "build:android:release:passenger": "node scripts/run-android-release-flavor.cjs passenger",
    "build:android:release:driver": "node scripts/run-android-release-flavor.cjs driver",
    "build:android:cloud:apk:preview": "npx eas-cli@18.9.1 build --platform android --profile preview --non-interactive",
    "build:android:cloud:aab:production": "npx eas-cli@18.9.1 build --platform android --profile production --non-interactive",
    "build:android:cloud:aab:production:passenger": "npx eas-cli@18.9.1 build --platform android --profile production_passenger --non-interactive",
    "build:android:cloud:aab:production:driver": "npx eas-cli@18.9.1 build --platform android --profile production_driver --non-interactive",
    "build:android:cloud:apk:production": "npm run build:android:cloud:aab:production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@supabase/supabase-js": "^2.99.1",
    "expo": "~55.0.6",
    "expo-constants": "^55.0.7",
    "expo-linking": "^55.0.7",
    "expo-location": "^55.1.2",
    "expo-notifications": "^55.0.12",
    "expo-secure-store": "^55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-task-manager": "~55.0.15",
    "h3-js": "^4.1.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-maps": "1.26.20",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
