{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_FLAVOR": "passenger",
        "EXPO_PUBLIC_APP_FLAVOR": "passenger"
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_FLAVOR": "passenger",
        "EXPO_PUBLIC_APP_FLAVOR": "passenger"
      }
    },
    "production_passenger": {
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "prebuildCommand": "npx expo prebuild --platform android --clean",
      "env": {
        "APP_FLAVOR": "passenger",
        "EXPO_PUBLIC_APP_FLAVOR": "passenger"
      }
    },
    "production_driver": {
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "prebuildCommand": "npx expo prebuild --platform android --clean",
      "env": {
        "APP_FLAVOR": "driver",
        "EXPO_PUBLIC_APP_FLAVOR": "driver"
      }
    },
    "production_aab": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "prebuildCommand": "npx expo prebuild --platform android --clean",
      "env": {
        "APP_FLAVOR": "passenger",
        "EXPO_PUBLIC_APP_FLAVOR": "passenger"
      }
    },
    "production_passenger_aab": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "prebuildCommand": "npx expo prebuild --platform android --clean",
      "env": {
        "APP_FLAVOR": "passenger",
        "EXPO_PUBLIC_APP_FLAVOR": "passenger"
      }
    },
    "production_driver_aab": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "prebuildCommand": "npx expo prebuild --platform android --clean",
      "env": {
        "APP_FLAVOR": "driver",
        "EXPO_PUBLIC_APP_FLAVOR": "driver"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
